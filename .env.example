# Trading Bot Configuration - Paper Trading Setup
# Copy this file to .env and configure your settings

# ====================
# BROKER CONFIGURATION
# ====================

# Broker selection
# paper_ccxt = Paper trading with real market data (SAFE - Recommended)
# ccxt = Live trading with real money (DANGEROUS - Requires API keys)
BROKER=paper_ccxt

# Exchange name: binance, kraken, coinbase, bybit, etc.
EXCHANGE_NAME=binance

# Trading symbol (use :USDT suffix for futures)
# Examples: BTC/USDT:USDT, ETH/USDT:USDT
SYMBOLS=BTC/USDT:USDT

# Timeframe for data and signals
# Options: 1m, 5m, 15m, 30m, 1h, 4h, 1d
TIMEFRAME=1m

# ====================
# TRADING CONFIGURATION  
# ====================

# Trading type: 'spot' or 'future'
# spot = No leverage, no shorting
# future = Leverage available, shorting allowed
TRADING_TYPE=future

# Allow short selling (true/false)
# Only applies when TRADING_TYPE=future
ALLOW_SHORTING=true

# ====================
# TRADING MODE
# ====================

# Use sandbox/testnet data (true) or real market data (false)
# true = Use exchange testnet (if available)
# false = Use real market data (recommended for paper trading)
USE_SANDBOX=false

# ====================
# API KEYS (Optional)
# ====================

# For paper trading with public data - leave empty
# For live trading - add your exchange API credentials
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# ====================
# STRATEGY CONFIGURATION
# ====================

# Strategy to use
# Options: sma, breakout, fvg, mean_reversion, test
STRATEGY_NAME=sma

# ====================
# FEES & SLIPPAGE (Paper Trading)
# ====================

# Commission rate per trade (0.001 = 0.1%)
# Binance futures: 0.0002-0.0004, Spot: 0.001
COMMISSION_RATE=0.001

# Slippage rate for market impact (0.0005 = 0.05%)
# Simulates price movement against you during execution
SLIPPAGE_RATE=0.0005

# ====================
# RISK MANAGEMENT
# ====================

# Initial trading capital (virtual money for paper trading)
INITIAL_CAPITAL=10000.0

# Maximum position size as percentage of portfolio (0.1 = 10%)
MAX_POSITION_SIZE=0.1

# ====================
# LOGGING
# ====================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Use JSON logging format (true/false)
USE_JSON_LOGS=false