# Trading Bot Configuration
# Copy this file to .env and configure your settings

# ====================
# BROKER CONFIGURATION
# ====================

# Broker selection: ccxt, ibkr, paper_ccxt, paper_ibkr
BROKER=paper_ccxt

# ====================
# CCXT CONFIGURATION (for crypto trading)
# ====================

# Exchange name: binance, kraken, coinbase, etc.
CCXT_EXCHANGE=binance

# API credentials (get from exchange)
CCXT_API_KEY=your_api_key_here
CCXT_API_SECRET=your_api_secret_here

# Use testnet/sandbox mode (if exchange supports it)
CCXT_TESTNET=true

# ====================
# IBKR CONFIGURATION (for stocks/forex/futures)
# ====================

# IB Gateway/TWS connection
IBKR_HOST=127.0.0.1
IBKR_PORT=7497  # 7497 for live, 7496 for paper
IBKR_CLIENT_ID=1

# Account settings
IBKR_ACCOUNT=DU123456  # Your account ID

# ====================
# TRADING CONFIGURATION
# ====================

# Strategy to use (must match strategy name in framework/strategies/)
STRATEGY=sma

# Trading symbol
# For CCXT: BTC/USDT, ETH/USDT, etc.
# For IBKR: SPY, AAPL, EUR.USD, etc.
SYMBOL=BTC/USDT

# Timeframe for data and signals
# Options: 1m, 5m, 15m, 30m, 1h, 4h, 1d
TIMEFRAME=15m

# ====================
# RISK MANAGEMENT
# ====================

# Initial trading capital
INITIAL_CAPITAL=10000

# Maximum position size as percentage of portfolio (0.1 = 10%)
MAX_POSITION_PCT=0.1

# Stop loss percentage (0.02 = 2%)
STOP_LOSS_PCT=0.02

# Take profit percentage (0.04 = 4%)
TAKE_PROFIT_PCT=0.04

# Risk per trade (for position sizing)
RISK_PER_TRADE=0.01

# ====================
# STRATEGY PARAMETERS
# ====================

# These can be passed as JSON string
# Example for SMA strategy:
STRATEGY_PARAMS={"short_window": 20, "long_window": 50}

# Or individual parameters:
# STRATEGY_SHORT_WINDOW=20
# STRATEGY_LONG_WINDOW=50

# ====================
# DATABASE CONFIGURATION
# ====================

# PostgreSQL connection
DB_HOST=localhost  # Use 'postgres' when running in Docker
DB_PORT=5432
DB_NAME=trading
DB_USER=trading_user
DB_PASSWORD=trading_password

# ====================
# LOGGING CONFIGURATION
# ====================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Use JSON logging format
USE_JSON_LOGS=true

# ====================
# SAFETY FEATURES
# ====================

# Enable paper trading mode (overrides broker settings)
PAPER_TRADING=true

# Maximum daily loss (trading stops if exceeded)
MAX_DAILY_LOSS=0.05  # 5% of capital

# Maximum number of trades per day
MAX_DAILY_TRADES=10

# Require manual confirmation for live trades
REQUIRE_CONFIRMATION=false

# ====================
# MONITORING
# ====================

# Enable metrics endpoint
ENABLE_METRICS=true
METRICS_PORT=8000

# Heartbeat interval (seconds)
HEARTBEAT_INTERVAL=60