          "rawQuery": true,
          "rawSql": "SELECT \n  CASE \n    WHEN COUNT(*) = 0 THEN 0\n    ELSE (\n      COUNT(CASE WHEN \n        (side = 'long' AND COALESCE(exit_price, 0) > entry_price) OR\n        (side = 'short' AND COALESCE(exit_price, 0) < entry_price)\n      THEN 1 END)::float / COUNT(*) * 100\n    )\n  END AS \"Win Rate\"\nFROM positions\nWHERE status = 'closed' AND exit_price IS NOT NULL",
          "refId": "A"
        }
      ],
      "title": "Win Rate",
      "type": "gauge"
