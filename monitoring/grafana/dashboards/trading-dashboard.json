      "targets": [
        {
          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT \n  COALESCE(SUM(\n    CASE \n      WHEN side = 'long' THEN \n        CASE WHEN status = 'closed' THEN \n          (COALESCE(exit_price, 0) - entry_price) * quantity\n        ELSE 0 END\n      WHEN side = 'short' THEN \n        CASE WHEN status = 'closed' THEN \n          (entry_price - COALESCE(exit_price, 0)) * quantity\n        ELSE 0 END\n      ELSE 0\n    END\n  ), 0) AS \"Total PnL\"\nFROM positions\nWHERE status = 'closed'",
          "refId": "A"
        }
      ],
      "title": "Total Realized PnL",
      "type": "gauge"
    },
