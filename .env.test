# Test configuration for paper trading with CCXT/Binance

# Broker configuration
BROKER=paper_ccxt
CCXT_EXCHANGE=binance
CCXT_TESTNET=false  # Use real market data for realistic testing

# No API keys needed for public market data
CCXT_API_KEY=
CCXT_API_SECRET=

# Trading configuration
STRATEGY=breakout
SYMBOL=BTC/USDT:USDT
TIMEFRAME=15m

# Risk management
INITIAL_CAPITAL=10000
MAX_POSITION_PCT=0.1
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
RISK_PER_TRADE=0.01

# Strategy parameters for breakout (use defaults by leaving empty)
STRATEGY_PARAMS={}

# Safety
PAPER_TRADING=true
MAX_DAILY_LOSS=0.05
MAX_DAILY_TRADES=10

# Logging
LOG_LEVEL=INFO
USE_JSON_LOGS=false

# Database (optional, comment out to run without DB)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=trading
# DB_USER=trading_user
# DB_PASSWORD=trading_password